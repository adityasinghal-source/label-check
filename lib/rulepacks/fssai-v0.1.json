{
  "id": "fssai",
  "label": "India (FSSAI)",
  "version": "0.1",
  "allergenRuleId": "FSSAI-ALG-001",
  "rules": [
    {
      "id": "FSSAI-DC-001",
      "name": "Claim to prevent, treat or cure a disease",
      "severity": "high",
      "checkedBy": "ai",
      "citation": "Food Safety and Standards Act, 2006; FSS (Advertising and Claims) Regulations, 2018",
      "aiGuidance": "Flag wording that says or implies the food prevents, treats, cures, manages or alleviates a specific disease or medical condition (or a symptom of one), or that it is meant for people who have one. Food labels in India may not make such claims. Flag, for example: \"helps manage diabetes\", \"controls blood pressure\", \"prevents heart disease\", \"good for diabetics\", \"cures joint pain\". Do NOT flag wording about supporting normal, healthy body function that names no disease, condition or symptom: \"supports healthy blood sugar\", \"supports immunity\", \"builds strong bones\", \"high protein\". Tie-break: if the wording does not name a disease, condition or symptom, and does not say the food is for people who have one, do not flag it."
    },
    {
      "id": "FSSAI-ALG-001",
      "name": "Allergen not declared",
      "severity": "high",
      "checkedBy": "code",
      "citation": "FSS (Labelling and Display) Regulations, 2020 (declaration of food allergens)"
    }
  ],
  "allergens": [
    {
      "name": "Gluten",
      "keywords": ["wheat", "semolina", "durum", "spelt", "barley", "rye", "oat", "malt", "maida", "atta", "sooji", "suji"],
      "exclude": ["buckwheat"],
      "declaredBy": ["gluten", "wheat", "barley", "rye", "oat", "spelt"],
      "nameSpecific": true
    },
    {
      "name": "Crustaceans",
      "keywords": ["shrimp", "prawn", "crab", "lobster", "crayfish", "krill"],
      "declaredBy": ["crustacean", "shellfish", "shrimp", "prawn", "crab", "lobster", "crayfish", "krill"],
      "nameSpecific": true
    },
    {
      "name": "Milk",
      "keywords": ["milk", "whey", "casein", "caseinate", "butter", "buttermilk", "cream", "cheese", "yogurt", "yoghurt", "lactose", "ghee", "lactalbumin", "curd", "dahi", "paneer", "khoa"],
      "exclude": ["peanut butter", "cocoa butter", "shea butter", "nut butter", "almond butter", "cashew butter", "almond milk", "oat milk", "soy milk", "rice milk", "coconut milk", "coconut cream", "cream of tartar"],
      "declaredBy": ["milk", "dairy"]
    },
    {
      "name": "Egg",
      "keywords": ["egg", "albumen", "albumin", "mayonnaise", "meringue"],
      "exclude": ["eggplant", "lactalbumin"],
