      "exclude": ["shellfish"],
      "declaredBy": ["fish", "anchovy", "anchovies", "salmon", "tuna", "cod", "tilapia", "sardine", "mackerel", "pollock"],
      "nameSpecific": true
    },
    {
      "name": "Peanuts",
      "keywords": ["peanut", "groundnut", "arachis"],
      "declaredBy": ["peanut", "groundnut"]
    },
    {
      "name": "Tree nuts",
      "keywords": ["almond", "cashew", "walnut", "pecan", "pistachio", "hazelnut", "macadamia", "brazil nut", "pine nut"],
      "declaredBy": ["almond", "cashew", "walnut", "pecan", "pistachio", "hazelnut", "macadamia", "brazil nut", "pine nut"],
      "nameSpecific": true
    },
    {
